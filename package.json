{
  "name": "expense-tracker",
  "version": "1.0.0",
  "description": "桌面端消费记账应用",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.main.json",
    "build:android": "npm run build:vite && npx cap sync android",
    "pack:exe": "npm run build && node scripts/pack-exe.js",
    "pack:apk": "npm run build:vite && npx cap sync android && node scripts/pack-apk.js",
    "open:android": "npx cap open android",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "keywords": [
    "electron",
    "react",
    "expense",
    "tracker"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@playwright/test": "^1.60.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^4.1.6",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.1",
    "@vercel/speed-insights": "^2.0.0",
    "antd": "^5.12.8",
    "dayjs": "^1.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.1.0",
    "recharts": "^2.10.3",
    "sql.js": "^1.14.1"
  }
}
